# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...        # SOLO backend, jamás en el frontend ni en Git

# ---- Meta / WhatsApp ----
WA_VERIFY_TOKEN=una-clave-secreta-que-inventes
# Los tokens de WhatsApp de cada cliente NO van acá:
# viven en la tabla `canales` (columna token_acceso), uno por número conectado.

# ---- OpenAI (motor de los agentes + embeddings) ----
OPENAI_API_KEY=sk-...

PORT=3000

# ---- App de Meta (para que los clientes conecten sus redes) ----
META_APP_ID=1234567890
META_APP_SECRET=abc123...
OAUTH_REDIRECT_URL=https://tu-backend.railway.app/conectar/meta/callback
OAUTH_STATE_SECRET=otra-clave-secreta-larga-que-inventes
